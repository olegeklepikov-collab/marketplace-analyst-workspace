{"unit_id": "1928647892:TITLE:0:56", "sku": "1928647892", "surface": "TITLE", "source_file": "01_Карточки/Ozon/Билайн/П39 билайн - официальный магазин/1928647892/CS_f053c54596d2fb7de6c7/01_Материалы/card_data.json", "source_field": "title", "start": 0, "end": 56, "text": "Сим карта Билайн, тариф Эксклюзивный ХИТ, 350 руб./ мес.", "offset_unit": "UNICODE_CODE_POINT", "unit_kind": "SOURCE_SEGMENT", "atomicity": "SOURCE_SEGMENT_NOT_ASSUMED_SINGLE_PROPOSITION"}
