{"unit_id": "1867038245:DESCRIPTION:2318:2387", "sku": "1867038245", "surface": "DESCRIPTION", "source_file": "01_Карточки/Ozon/МегаФон/П23 МегаФон/1867038245/CS_d2576ee8cff509d03325/01_Материалы/card_data.json", "source_field": "description", "start": 2318, "end": 2387, "text": "Можно перейти на эту Сим-карту со своим номером от другого оператора?", "offset_unit": "UNICODE_CODE_POINT", "unit_kind": "SOURCE_SEGMENT", "atomicity": "SOURCE_SEGMENT_NOT_ASSUMED_SINGLE_PROPOSITION"}
