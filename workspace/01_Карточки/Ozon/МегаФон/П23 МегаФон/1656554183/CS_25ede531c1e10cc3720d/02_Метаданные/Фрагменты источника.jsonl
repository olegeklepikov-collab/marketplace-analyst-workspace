{"unit_id": "1656554183:DESCRIPTION:133:279", "sku": "1656554183", "surface": "DESCRIPTION", "source_file": "01_Карточки/Ozon/МегаФон/П23 МегаФон/1656554183/CS_25ede531c1e10cc3720d/01_Материалы/card_data.json", "source_field": "description", "start": 133, "end": 279, "text": "Приобретайте комплект из двух независимых Сим-карт с отличием всего в одну цифру. Парный номер — удобно для членов семьи или для разных устройств.", "offset_unit": "UNICODE_CODE_POINT", "unit_kind": "SOURCE_SEGMENT", "atomicity": "SOURCE_SEGMENT_NOT_ASSUMED_SINGLE_PROPOSITION"}
