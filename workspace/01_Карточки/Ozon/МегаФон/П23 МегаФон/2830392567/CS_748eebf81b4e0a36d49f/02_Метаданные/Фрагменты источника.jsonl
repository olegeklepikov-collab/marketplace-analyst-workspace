{"unit_id": "2830392567:DESCRIPTION:2110:2155", "sku": "2830392567", "surface": "DESCRIPTION", "source_file": "01_Карточки/Ozon/МегаФон/П23 МегаФон/2830392567/CS_748eebf81b4e0a36d49f/01_Материалы/card_data.json", "source_field": "description", "start": 2110, "end": 2155, "text": "Активация сим‑карты может занять до 30 минут.", "offset_unit": "UNICODE_CODE_POINT", "unit_kind": "SOURCE_SEGMENT", "atomicity": "SOURCE_SEGMENT_NOT_ASSUMED_SINGLE_PROPOSITION"}
