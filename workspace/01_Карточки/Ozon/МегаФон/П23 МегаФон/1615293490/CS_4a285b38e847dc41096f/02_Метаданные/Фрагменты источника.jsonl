{"unit_id": "1615293490:DESCRIPTION:1891:1933", "sku": "1615293490", "surface": "DESCRIPTION", "source_file": "01_Карточки/Ozon/МегаФон/П23 МегаФон/1615293490/CS_4a285b38e847dc41096f/01_Материалы/card_data.json", "source_field": "description", "start": 1891, "end": 1933, "text": "В каких регионах действуют тарифные планы?", "offset_unit": "UNICODE_CODE_POINT", "unit_kind": "SOURCE_SEGMENT", "atomicity": "SOURCE_SEGMENT_NOT_ASSUMED_SINGLE_PROPOSITION"}
