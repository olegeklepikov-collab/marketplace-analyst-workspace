{"unit_id": "1763772220:DESCRIPTION:643:660", "sku": "1763772220", "surface": "DESCRIPTION", "source_file": "01_Карточки/Ozon/МегаФон/П28 Мой товар/1763772220/CS_fd2d1f024cbf487f8000/01_Материалы/card_data.json", "source_field": "description", "start": 643, "end": 660, "text": "Вы не в роуминге.", "offset_unit": "UNICODE_CODE_POINT", "unit_kind": "SOURCE_SEGMENT", "atomicity": "SOURCE_SEGMENT_NOT_ASSUMED_SINGLE_PROPOSITION"}
