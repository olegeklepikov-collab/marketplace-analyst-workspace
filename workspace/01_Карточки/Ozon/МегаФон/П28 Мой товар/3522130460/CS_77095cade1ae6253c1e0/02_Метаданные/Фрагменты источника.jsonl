{"unit_id": "3522130460:TITLE:0:86", "sku": "3522130460", "surface": "TITLE", "source_file": "01_Карточки/Ozon/МегаФон/П28 Мой товар/3522130460/CS_77095cade1ae6253c1e0/01_Материалы/card_data.json", "source_field": "title", "start": 0, "end": 86, "text": "Сим-карта МегаФон безлимитный интернет, от 200 мин, 20 бесплатных запросов ИИ в неделю", "offset_unit": "UNICODE_CODE_POINT", "unit_kind": "SOURCE_SEGMENT", "atomicity": "SOURCE_SEGMENT_NOT_ASSUMED_SINGLE_PROPOSITION"}
